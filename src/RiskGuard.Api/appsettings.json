{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": "",
    "JobsConnectionString": ""
  },
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Https": {
    "RedirectToHttps": false
  },
  "Identity": {
    "Provider": "Auth0",
    "Audience": "",
    "TenantClaim": "https://riskguard.app/tenant_id",
    "Auth0": {
      "Domain": "",
      "ClientId": "",
      "ClientSecret": "",
      "Connection": "Username-Password-Authentication",
      "PasswordTicketTtlSeconds": 432000
    }
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "riskguard:"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Security": {
    "EncryptionKey": ""
  },
  "PlatformApis": {
    "TimeoutSeconds": 10,
    "UserAgent": "RiskGuard/1.0 (configure um contato real, exigido pela Nuvemshop)",
    "Platforms": {}
  },
  "Retention": {
    "Enabled": true,
    "RawPayloadDays": 30,
    "AuditDays": 365,
    "Cron": "0 3 * * *"
  },
  "Hangfire": {
    "WorkerCount": 5,
    "MaxRetryAttempts": 5,
    "ServerEnabled": true
  }
}

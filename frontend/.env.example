# Copie para .env.local e preencha. Nada aqui e segredo: sao valores publicos do app SPA no Auth0.
# Ver docs/auth0-setup.md (secao do frontend).

# URL da API RiskGuard (a origem deste frontend precisa estar em Cors:AllowedOrigins da API)
VITE_API_URL=http://localhost:5080

# Auth0: aplicacao "Single Page Application"
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
# Mesmo valor de Identity:Audience da API (identificador da API no Auth0)
VITE_AUTH0_AUDIENCE=https://api.riskguard.app

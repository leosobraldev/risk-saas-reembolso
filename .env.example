# Modelo do .env usado pelo docker-compose.yml. Copie para .env (que NAO e versionado) e preencha.
# Os valores marcados como PUBLICO tambem vao no painel; o CLIENT_SECRET e segredo: nunca no Git.

# Chave AES-256 em base64 (32 bytes). A de desenvolvimento esta em src/RiskGuard.Api/appsettings.Development.json.
SECURITY_ENCRYPTION_KEY=

IDENTITY_AUDIENCE=https://api.riskguard.app
IDENTITY_AUTH0_DOMAIN=seu-tenant.us.auth0.com
# aplicacao Machine to Machine "RiskGuard Backend"
IDENTITY_AUTH0_CLIENT_ID=
IDENTITY_AUTH0_CLIENT_SECRET=

# PUBLICO: Client ID da aplicacao SPA "RiskGuard Painel"
VITE_AUTH0_CLIENT_ID=

# So para teste de carga (scripts/load-webhooks.py). Padroes do produto: 100 / 3000 / 600 por minuto.
# RATE_LIMIT_PERMIT=100
# RATE_LIMIT_WEBHOOK_IP=3000
# RATE_LIMIT_WEBHOOK_TENANT=600
